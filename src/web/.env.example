# Frontend OAuth + Worker config.
# These VITE_* values are baked into the SPA bundle at build time, so they
# are public. The OAuth client_id IS public by design; never put a secret here.

# OAuth App client_id (public)
VITE_GITHUB_CLIENT_ID=

# Cloudflare Worker base URL (no trailing slash)
# Production example: https://promptlibrary-auth.<account>.workers.dev
# Local dev example:  http://localhost:8787
VITE_WORKER_URL=
