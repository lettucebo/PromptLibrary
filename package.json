{
  "name": "prompt-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "vite --config src/web/vite.config.ts",
    "build": "tsc -p src/web/tsconfig.json && vite --config src/web/vite.config.ts build",
    "preview": "vite --config src/web/vite.config.ts preview",
    "typecheck": "tsc -p src/web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@tanstack/react-query": "^5.62.7",
    "@uiw/react-md-editor": "^4.0.4",
    "diff": "^9.0.0",
    "i18next": "^24.0.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.4",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
